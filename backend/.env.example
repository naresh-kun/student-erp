# =============================================================================
# Student ERP — Backend Environment Configuration Example (.env.example)
# Copy this file to .env for local development and adjust settings as needed.
# NEVER commit real production credentials or secret keys to version control.
# =============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-master-key-phase-3-foundation-student-erp
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16+)
# Dual-Role Architecture (Option B):
# Runtime application role (restricted DML: SELECT, INSERT on audit_logs, no DDL):
DATABASE_USER=erp_app
DATABASE_PASSWORD=erp_app_password
DATABASE_NAME=student_erp
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Migration role (schema/table owner with DDL & trigger execution privileges):
# Used when executing `python manage.py migrate` with DB_ROLE=migrator:
MIGRATOR_DB_USER=erp_migrator
MIGRATOR_DB_PASSWORD=erp_migrator_password

# Set DB_ROLE=migrator during migration execution; leave unset or app for runtime server:
DB_ROLE=app

# Compatibility aliases (legacy fallback):
# DB_NAME=student_erp
# DB_USER=erp_app
# DB_PASSWORD=erp_app_password
# DB_HOST=localhost
# DB_PORT=5432

# Alternative single connection string (used in Docker Compose / Twelve-Factor):
# DATABASE_URL=postgres://erp_app:erp_app_password@localhost:5432/student_erp
# MIGRATOR_DATABASE_URL=postgres://erp_migrator:erp_migrator_password@localhost:5432/student_erp

# Redis & Channels Configuration (Phase 6 Realtime)
REDIS_URL=redis://localhost:6379/1

# CORS Allowed Origins (Comma-separated for React SPA)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT & Authentication Configuration (Phase 4 Foundation)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_SIGNING_KEY=
JWT_ISSUER=student-erp-api

